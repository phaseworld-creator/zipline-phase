# ============================================================
#  Zipline Phase — Example Environment File
#  Copy this to .env and fill in the values.
#  Lines starting with # are comments and are ignored.
# ============================================================


# ── PostgreSQL ───────────────────────────────────────────────
# Credentials used by both the postgres container and Zipline.

POSTGRESQL_USER=zipline
POSTGRESQL_PASSWORD=changeme          # CHANGE THIS in production
POSTGRESQL_DB=zipline

# DATABASE_URL is built automatically by docker-compose from the vars above.
# You only need to set this manually if you're running outside of Docker.
# DATABASE_URL=postgres://zipline:changeme@localhost:5432/zipline


# ── Zipline Core (required) ───────────────────────────────────

# Secret key — must be at least 32 characters. Used for session signing.
# Generate one: openssl rand -hex 32
CORE_SECRET=changethischangethischangethischangethis

# Server port and hostname (default: 3000 / 0.0.0.0)
# CORE_PORT=3000
# CORE_HOSTNAME=0.0.0.0

# Set to true if behind a reverse proxy (Cloudflare, nginx, etc.)
CORE_TRUST_PROXY=true

# Set to true to force https:// in returned file URLs
# CORE_RETURN_HTTPS_URLS=false

# Default domain for returned URLs (e.g. zipline.example.com)
# CORE_DEFAULT_DOMAIN=


# ── Cloudflare Tunnel ─────────────────────────────────────────
# Get your token from: https://one.dash.cloudflare.com/
#   Networks → Tunnels → Create a tunnel → Docker → copy the token
# In the tunnel dashboard set the public hostname to point at:
#   http://zipline:3000

CLOUDFLARE_TUNNEL_TOKEN=your_cloudflare_tunnel_token_here


# ── Datasource ────────────────────────────────────────────────
# Where uploaded files are stored. Default: local (inside the container).
# DATASOURCE_TYPE=local
# DATASOURCE_LOCAL_DIRECTORY=./uploads

# S3-compatible storage (uncomment and fill in to use instead of local)
# DATASOURCE_TYPE=s3
# DATASOURCE_S3_ACCESS_KEY_ID=
# DATASOURCE_S3_SECRET_ACCESS_KEY=
# DATASOURCE_S3_REGION=us-east-1
# DATASOURCE_S3_BUCKET=my-zipline-bucket
# DATASOURCE_S3_ENDPOINT=                   # leave blank for AWS, set for Cloudflare R2/Minio etc.
# DATASOURCE_S3_FORCE_PATH_STYLE=false
# DATASOURCE_S3_SUBDIRECTORY=               # optional prefix inside the bucket


# ── Files ─────────────────────────────────────────────────────
# FILES_ROUTE=/u
# FILES_LENGTH=6
# FILES_DEFAULT_FORMAT=random              # random | date | uuid | name | gfycat
# FILES_MAX_FILE_SIZE=100mb
# FILES_DEFAULT_EXPIRATION=                # e.g. 7d, 24h — blank = never
# FILES_MAX_FILES_PER_UPLOAD=1000
# FILES_ASSUME_MIMETYPES=false
# FILES_REMOVE_GPS_METADATA=false
# FILES_EXTENSIONLESS_URLS=false
# FILES_DEFAULT_COMPRESSION_FORMAT=jpg


# ── URLs / Shortener ──────────────────────────────────────────
# URLS_ROUTE=/go
# URLS_LENGTH=6


# ── Features ──────────────────────────────────────────────────
# FEATURES_USER_REGISTRATION=false
# FEATURES_OAUTH_REGISTRATION=false
# FEATURES_IMAGE_COMPRESSION=true
# FEATURES_ROBOTS_TXT=true
# FEATURES_HEALTHCHECK=true
# FEATURES_DELETE_ON_MAX_VIEWS=true
# FEATURES_PUBLIC_UPLOAD_PORTAL=false
# FEATURES_ONE_TIME_SHARE_LINKS=true
# FEATURES_SOUNDBOARD=false
# FEATURES_ADVANCED_ANALYTICS=false
# FEATURES_VERSION_CHECKING=true

# Thumbnails
# FEATURES_THUMBNAILS_ENABLED=true
# FEATURES_THUMBNAILS_FORMAT=jpg           # jpg | png | webp
# FEATURES_THUMBNAILS_NUM_THREADS=4
# FEATURES_THUMBNAILS_INSTANTANEOUS=false

# Metrics
# FEATURES_METRICS_ENABLED=true
# FEATURES_METRICS_ADMIN_ONLY=false
# FEATURES_METRICS_SHOW_USER_SPECIFIC=true

# Watermark
# FEATURES_WATERMARK_ENABLED=false
# FEATURES_WATERMARK_TEXT=
# FEATURES_WATERMARK_IMAGE=
# FEATURES_WATERMARK_POSITION=center      # center | top-left | top-right | bottom-left | bottom-right | tile
# FEATURES_WATERMARK_OPACITY=50

# Virus scanning
# FEATURES_VIRUS_SCANNING_ENABLED=false
# FEATURES_VIRUS_SCANNING_PROVIDER=       # virustotal
# FEATURES_VIRUS_TOTAL_API_KEY=


# ── Website ───────────────────────────────────────────────────
# WEBSITE_TITLE=Zipline
# WEBSITE_TITLE_LOGO=
# WEBSITE_LOGIN_BACKGROUND=
# WEBSITE_LOGIN_BACKGROUND_BLUR=true
# WEBSITE_DEFAULT_AVATAR=
# WEBSITE_TOS=
# WEBSITE_THEME_DEFAULT=system
# WEBSITE_THEME_DARK=builtin:dark_gray
# WEBSITE_THEME_LIGHT=builtin:light_gray


# ── Invites ───────────────────────────────────────────────────
# INVITES_ENABLED=true
# INVITES_LENGTH=6


# ── MFA ───────────────────────────────────────────────────────
# MFA_TOTP_ENABLED=false
# MFA_TOTP_ISSUER=Zipline
# MFA_PASSKEYS_ENABLED=false
# MFA_PASSKEYS_RP_ID=                     # e.g. zipline.example.com
# MFA_PASSKEYS_ORIGIN=                    # e.g. https://zipline.example.com


# ── OAuth ─────────────────────────────────────────────────────
# OAUTH_BYPASS_LOCAL_LOGIN=false
# OAUTH_LOGIN_ONLY=false

# Discord OAuth
# OAUTH_DISCORD_CLIENT_ID=
# OAUTH_DISCORD_CLIENT_SECRET=
# OAUTH_DISCORD_REDIRECT_URI=https://zipline.example.com/api/auth/oauth/discord
# OAUTH_DISCORD_ALLOWED_IDS=             # comma-separated Discord user IDs to allow
# OAUTH_DISCORD_DENIED_IDS=              # comma-separated Discord user IDs to block

# Google OAuth
# OAUTH_GOOGLE_CLIENT_ID=
# OAUTH_GOOGLE_CLIENT_SECRET=
# OAUTH_GOOGLE_REDIRECT_URI=https://zipline.example.com/api/auth/oauth/google

# GitHub OAuth
# OAUTH_GITHUB_CLIENT_ID=
# OAUTH_GITHUB_CLIENT_SECRET=
# OAUTH_GITHUB_REDIRECT_URI=https://zipline.example.com/api/auth/oauth/github

# OpenID Connect (generic)
# OAUTH_OIDC_CLIENT_ID=
# OAUTH_OIDC_CLIENT_SECRET=
# OAUTH_OIDC_AUTHORIZE_URL=
# OAUTH_OIDC_TOKEN_URL=
# OAUTH_OIDC_USERINFO_URL=
# OAUTH_OIDC_REDIRECT_URI=https://zipline.example.com/api/auth/oauth/oidc


# ── Rate Limiting ─────────────────────────────────────────────
# RATELIMIT_ENABLED=true
# RATELIMIT_MAX=10
# RATELIMIT_WINDOW=
# RATELIMIT_ADMIN_BYPASS=true
# RATELIMIT_ALLOW_LIST=                   # comma-separated IPs to bypass rate limits


# ── HTTP Webhooks ─────────────────────────────────────────────
# POST requests sent to these URLs on the respective events.
# HTTP_WEBHOOK_ON_UPLOAD=
# HTTP_WEBHOOK_ON_SHORTEN=
# HTTP_WEBHOOK_ON_DELETE=
# HTTP_WEBHOOK_ON_SIGNUP=
# HTTP_WEBHOOK_ON_QUOTA=


# ── Discord Webhooks ──────────────────────────────────────────
# Global fallback — used when per-event URLs are not set.
# DISCORD_WEBHOOK_URL=
# DISCORD_USERNAME=Zipline
# DISCORD_AVATAR_URL=

# Per-event overrides (all optional)
# DISCORD_ON_UPLOAD_WEBHOOK_URL=
# DISCORD_ON_UPLOAD_USERNAME=
# DISCORD_ON_UPLOAD_AVATAR_URL=
# DISCORD_ON_UPLOAD_CONTENT=
# DISCORD_ON_SHORTEN_WEBHOOK_URL=
# DISCORD_ON_SHORTEN_USERNAME=
# DISCORD_ON_SHORTEN_AVATAR_URL=
# DISCORD_ON_SHORTEN_CONTENT=
# DISCORD_ON_DELETE_WEBHOOK_URL=
# DISCORD_ON_DELETE_USERNAME=
# DISCORD_ON_DELETE_AVATAR_URL=
# DISCORD_ON_DELETE_CONTENT=
# DISCORD_ON_SIGNUP_WEBHOOK_URL=
# DISCORD_ON_SIGNUP_USERNAME=
# DISCORD_ON_SIGNUP_AVATAR_URL=
# DISCORD_ON_SIGNUP_CONTENT=


# ── PWA ───────────────────────────────────────────────────────
# PWA_ENABLED=false
# PWA_TITLE=Zipline
# PWA_SHORT_NAME=Zipline
# PWA_DESCRIPTION=Zipline
# PWA_THEME_COLOR=#000000
# PWA_BACKGROUND_COLOR=#000000


# ── Misc / Debug ──────────────────────────────────────────────
# Skip the safety check that prevents starting with an empty DB + existing uploads
# ZIPLINE_SKIP_SAFETY_CHECK=1

# GitHub token for version checking (avoids rate limits)
# ZIPLINE_GITHUB_TOKEN=

# Custom FFmpeg path (if not in system PATH)
# FFMPEG_PATH=

# Enable debug logging (comma-separated namespaces, or * for all)
# DEBUG=
